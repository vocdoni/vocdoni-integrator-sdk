{
  "name": "@vocdoni/api-voting-zk",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "description": "ZK/anonymous voting for the Vocdoni SaaS API",
  "keywords": [
    "vocdoni",
    "voting",
    "zk",
    "anonymous",
    "snark"
  ],
  "homepage": "https://github.com/vocdoni/vocdoni-integrator-sdk",
  "bugs": "https://github.com/vocdoni/vocdoni-integrator-sdk/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/vocdoni/vocdoni-integrator-sdk.git",
    "directory": "packages/api-voting-zk"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "@vocdoni/api-types": "workspace:*",
    "@vocdoni/api-voting": "workspace:*",
    "@vocdoni/proto": "1.15.14",
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "tsconfig": "workspace:*",
    "tsdown": "^0.22.3",
    "typescript": "^5.7.0"
