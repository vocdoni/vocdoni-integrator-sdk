{
  "name": "@vocdoni/integrator-sdk",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Vocdoni Integrator SDK monorepo",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "turbo run build && vitest run --config integration/vitest.config.ts",
    "test:integration:stack": "scripts/integration-stack.sh run",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo run dev --parallel",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vocdoni/api-client": "workspace:*",
    "@vocdoni/api-types": "workspace:*",
    "@vocdoni/api-voting": "workspace:*",
    "@vocdoni/ballot": "workspace:*",
    "clean-package": "^2.2.0",
    "jsdom": "^30.0.1",
    "msw": "^2.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">= 22.12"
  },
  "packageManager": "pnpm@11.7.0"
}
